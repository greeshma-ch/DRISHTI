# Secrets (required)
MODEL_API_KEY=
TELEGRAM_BOT_TOKEN=

# Meta Model API
META_BASE_URL=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1

# Set to 1 for final eval and demo recording (bypasses dev-call block above $120)
FINAL_RUN=

# Emergency (P6)
# IMPORTANT: Generate a strong random secret: openssl rand -hex 32
EMERGENCY_HMAC_SECRET=
# Set to 1 to log instead of sending real Telegram messages (for testing)
EMERGENCY_DRY_RUN=1
# Contacts JSON for emergency button (client-side, Vite-injected)
# Format: [{"id":"contact-1","name":"Contact Name","telegramChatId":"real_chat_id"}]
# Demo placeholder (non-numeric IDs so no fake id can be sent)
VITE_EMERGENCY_CONTACTS_JSON='[{"id":"demo-1","name":"Demo Contact","telegramChatId":"demo-chat-id"}]'
